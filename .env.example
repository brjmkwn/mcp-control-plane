# Environment configuration for mcp-control-plane
# NEVER commit .env to version control

# Gateway Transport & Security
# Comma-separated list of allowed origins for DNS rebinding protection
MCP_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Scoped Bearer Tokens mapping (JSON string of token -> {client_id, scopes})
# Valid scopes: read:db, read:github, write:github, read:ops, admin
MCP_TOKENS_JSON='{"test-admin-token":{"client_id":"admin-svc","scopes":["admin","read:db","read:github","write:github","read:ops"]},"test-analytics-token":{"client_id":"analytics-agent","scopes":["read:db"]},"test-triage-token":{"client_id":"triage-bot","scopes":["read:github","write:github"]},"test-ops-token":{"client_id":"monitoring-agent","scopes":["read:ops"]}}'

# Secret key for HMAC-SHA256 2-step confirmation tokens (minimum 32 chars)
MCP_CONFIRMATION_SECRET="replace-with-a-secure-random-32-character-secret-key"

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL="postgresql://mcp_user:mcp_password@localhost:5432/mcp_db"

# Redis Configuration (Sliding window rate limiter & confirmation nonce store)
REDIS_URL="redis://localhost:6379/0"

# GitHub Triage Server
# GITHUB_PROVIDER_MODE can be "mock" (offline/CI/benchmarks) or "live"
GITHUB_PROVIDER_MODE="mock"
GITHUB_TOKEN=""

# Observability Server (Prometheus scraper / API)
PROMETHEUS_URL="http://localhost:9090"

# Host & Port settings for HTTP transport
MCP_HOST="0.0.0.0"
MCP_PORT=8000

# Testing & Development Mode (uses in-memory SQLite and mock providers if true)
MCP_TEST_MODE=false
